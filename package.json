{
  "name": "george-sedra-consulting",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "check": "npm run lint && npm run build",
    "api:dev": "wrangler dev --config wrangler.jsonc",
    "api:typecheck": "tsc -p tsconfig.api.json",
    "api:types": "wrangler types --config wrangler.jsonc --env-interface CloudflareBindings",
    "api:deploy": "wrangler deploy --config wrangler.jsonc",
    "check:all": "npm run lint && npm run build && npm run api:typecheck",
    "api:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc",
    "api:seed:local": "wrangler d1 execute DB --local --file=api/seed/prototype_jobs.sql --config wrangler.jsonc"
  },
  "dependencies": {
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "@cloudflare/workers-types": "^5.20260906.1",
    "wrangler": "^4.129.0"
  }
}
